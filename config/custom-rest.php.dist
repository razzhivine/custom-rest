<?php
/**
 * Настройки пакета custom/rest: что открыто через REST API. Всё, чего здесь
 * нет, недоступно. Читает Custom\Rest\Config.
 *
 * Файл лежит в local/php_interface/config/custom-rest.php (его создаёт
 * `custom-rest install`). Рядом может лежать custom-rest.local.php (не в git)
 * с тем же форматом — его списки добавляются к этим. Так тестовые инфоблоки,
 * формы и блоки локального стенда не попадают на сервер.
 */
return [
    /**
     * Префикс методов: <префикс>.element.get, <префикс>.search, … Латиница и
     * цифры, части через точку. По умолчанию custom.rest.
     *
     * 'prefix' => 'custom.rest',
     */

    /**
     * Название права (scope), которое выдаётся вебхуку. По умолчанию равно
     * префиксу. Сменили — создайте вебхук заново (`custom-rest webhook`).
     *
     * 'scope' => 'custom.rest',
     */

    /**
     * Инфоблоки по API_CODE:
     *   read_properties — свойства, которые можно получить (properties[])
     *   и по которым можно сортировать (PROPERTY.<CODE> в order).
     * Фильтровать можно по read_properties и по свойствам с флагом
     * «Показывать в умном фильтре» из админки.
     *
     * 'clubs' => ['read_properties' => ['FORMAT', 'AREA', 'PHOTOS']],
     */
    'iblocks' => [],

    /**
     * Веб-формы по символьному идентификатору (SID): 'FEEDBACK', …
     */
    'forms' => [],

    /**
     * Highload-блоки по NAME:
     *   fields — поля, которые можно получить, фильтровать и сортировать
     *   (ID доступен всегда); служебные поля в список не включайте;
     *   active_field — поле «да/нет», по которому запись скрыта (необязательно).
     *
     * 'Amenities' => ['fields' => ['UF_NAME', 'UF_XML_ID'], 'active_field' => 'UF_ACTIVE'],
     */
    'hlblocks' => [],

    /**
     * Карта сайта (<префикс>.sitemap.index / <префикс>.sitemap.get). В неё идут
     * все инфоблоки из iblocks: страница списка, разделы и элементы (если у
     * инфоблока есть шаблон URL). Здесь — только то, что отличается:
     *   page_size — адресов на страницу карты (по умолчанию 5000, не больше 50000);
     *   static — статические страницы: строка или ['url' => '/about/', 'lastmod' => '2026-01-15'];
     *   iblocks[<код>] — настройки инфоблока:
     *     list_page / sections / elements — false убирает этот вид страниц;
     *     exclude_property — код свойства элемента: любое непустое значение исключает элемент;
     *     exclude_section_field — код пользовательского поля раздела «Да/нет» (UF_…): раздел
     *       исключается вместе с подразделами и своими элементами;
     *     exclude_sections / exclude_elements — коды разделов и элементов, которые исключаются.
     *
     * 'sitemap' => [
     *     'static' => ['/', '/contacts/'],
     *     'iblocks' => ['clubs' => ['exclude_property' => 'NO_INDEX', 'exclude_section_field' => 'UF_NO_INDEX']],
     * ],
     */

    /**
     * Адрес сайта для ссылок на файлы («https://site.ru», без слеша в конце).
     * Нужен, если HTTPS снимается на прокси и PHP видит запрос как http.
     * Не задан — берётся из настроек сайта и протокола запроса.
     *
     * 'base_url' => 'https://site.ru',
     */

    /**
     * Сигнал фронту об изменении контента (Custom\Rest\Revalidate\Notifier). После
     * правки элемента, раздела или записи справочника из hlblocks Битрикс
     * отправляет POST на url, чтобы фронт пересобрал страницы, не дожидаясь
     * конца своего кеша. Не задан url — уведомлений нет.
     *   url — адрес на фронте, например https://site.ru/api/revalidate;
     *   secret — общий секрет: подпись тела в заголовке X-Rest-Signature;
     *   timeout — секунд на отправку (по умолчанию 3).
     *
     * 'revalidate' => ['url' => 'https://site.ru/api/revalidate', 'secret' => '…', 'timeout' => 3],
     */

    /**
     * Ограничения форм (значения по умолчанию — в FormApi::LIMITS,
     * здесь можно изменить любое; 0 — без ограничения):
     *   max_file_size, allowed_extensions, per_minute, per_hour, captcha_per_minute.
     *
     * 'form_limits' => ['per_minute' => 5, 'max_file_size' => 2 * 1024 * 1024],
     */
];
