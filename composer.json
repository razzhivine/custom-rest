{
    "name": "custom/rest",
    "description": "Headless REST API для 1С-Битрикс: инфоблоки, поиск, веб-формы, highload-блоки, карта сайта и уведомления фронту.",
    "type": "library",
    "keywords": ["bitrix", "1c-bitrix", "rest", "headless", "api", "iblock"],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "Custom\\Rest\\": "src/"
        }
    },
    "bin": ["bin/custom-rest"],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
