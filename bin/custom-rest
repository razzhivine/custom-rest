#!/usr/bin/env php
<?php
/**
 * Команды пакета custom/rest.
 *
 *   custom-rest install [--force]            копирует в проект образец настроек и страницу вебхуков для админки
 *   custom-rest webhook [--deactivate-others] создаёт пользователя и вебхук только с правом пакета, печатает адрес
 *   custom-rest help
 *
 * Корень сайта (папка с bitrix/ и local/): переменная BITRIX_ROOT или поиск вверх от текущей папки.
 * Команды webhook загружают Битрикс и должны запускаться тем же PHP и от того же пользователя, что и сайт.
 */

if (PHP_SAPI !== 'cli') {
    exit(1);
}

// Автозагрузчик: тот, что подставил Composer (vendor/bin), иначе рядом с пакетом.
$autoload = null;
foreach ([$GLOBALS['_composer_autoload_path'] ?? null, __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $candidate) {
    if (is_string($candidate) && is_file($candidate)) {
        $autoload = $candidate;
        break;
    }
}
if ($autoload === null) {
    fwrite(STDERR, "Не найден автозагрузчик Composer: выполните composer install\n");
    exit(1);
}
require $autoload;

/**
 * Корень сайта: BITRIX_ROOT, иначе первая папка вверх от текущей, где есть ядро Битрикса.
 */
function customRestRoot(): ?string
{
    $env = getenv('BITRIX_ROOT');
    if ($env !== false && $env !== '') {
        return rtrim($env, '/');
    }

    $dir = getcwd();
    while ($dir !== false && $dir !== dirname($dir)) {
        if (is_file($dir . '/bitrix/modules/main/include/prolog_before.php')) {
            return $dir;
        }
        $dir = dirname($dir);
    }

    return null;
}

$command = $argv[1] ?? 'help';
$flags = array_slice($argv, 2);

if ($command === 'help' || $command === '--help' || $command === '-h') {
    echo "Использование: custom-rest <команда>\n\n"
        . "  install [--force]             скопировать в проект образец настроек и страницу вебхуков\n"
        . "  webhook [--deactivate-others] создать вебхук только с правом пакета и напечатать его адрес\n\n"
        . "Корень сайта: BITRIX_ROOT или поиск вверх от текущей папки.\n";
    exit(0);
}

$root = customRestRoot();
if ($root === null) {
    fwrite(STDERR, "Не найден корень сайта: запустите из папки сайта или задайте BITRIX_ROOT\n");
    exit(1);
}

if ($command === 'install') {
    exit(\Custom\Rest\Cli\Installer::run($root, in_array('--force', $flags, true)));
}

if ($command === 'webhook') {
    $_SERVER['DOCUMENT_ROOT'] = $root;
    define('NO_KEEP_STATISTIC', true);
    define('NOT_CHECK_PERMISSIONS', true);
    define('NO_AGENT_CHECK', true);
    define('STOP_STATISTICS', true);
    require $root . '/bitrix/modules/main/include/prolog_before.php';

    exit(\Custom\Rest\Cli\Webhook::run(in_array('--deactivate-others', $flags, true)));
}

fwrite(STDERR, "Неизвестная команда: {$command}. Список команд: custom-rest help\n");
exit(1);
